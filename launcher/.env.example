# Copy to .env and fill in. Never commit or share .env.
# Use a fresh wallet holding only what you're willing to lose, not your main wallet.
SOLANA_PRIVATE_KEY=
# A paid/free RPC such as Helius; the public RPC drops transactions under load.
RPC_URL=https://api.mainnet-beta.solana.com
# https://twitterapi.io  (pay per use)
TWITTERAPI_KEY=
# https://app.pinata.cloud  (free tier is enough) - JWT with file upload permission
PINATA_JWT=
# https://pumpportal.fun - API key for the live trade feed; its linked wallet needs >= 0.02 SOL
PUMPPORTAL_API_KEY=
# Optional: Claude for naming. Without it, rule-based names are used.
ANTHROPIC_API_KEY=
